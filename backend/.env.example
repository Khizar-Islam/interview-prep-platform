# Copy this file, rename the copy to ".env" (no ".example" at the end),
# and fill in the real values below.

# Your PostgreSQL connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Example if using a local Postgres install:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/interview_prep"
DATABASE_URL=""

# Your Google Gemini API key (used by src/services/ai.service.js)
# Get this from aistudio.google.com > Get API key
GEMINI_API_KEY=""

# Shared secret used to verify sign-in tokens from the frontend.
# Must be at least 32 characters and EXACTLY the same as API_AUTH_SECRET in
# the frontend. The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
API_AUTH_SECRET=""

# Frontend URL(s) allowed to call this API from a browser, comma-separated,
# no trailing slash. Required: the server refuses to start without it.
# Example: FRONTEND_ORIGIN="http://localhost:3000,https://your-app.vercel.app"
FRONTEND_ORIGIN="http://localhost:3000"

# Optional. Number of proxies in front of the API in production, 1 to 5,
# default 1. Anything else falls back to 1. Ignored locally.
# On Render this MUST be 3 (measured: visitor, Cloudflare, Render proxy).
# A wrong value breaks the per-IP rate limits: too low and every visitor
# shares one IP counter; too high and visitors can fake their IP.
# TRUST_PROXY_HOPS=1

# Only for "npm run test:auth": a SEPARATE Neon branch (never your main database).
# The test refuses to run if this equals DATABASE_URL.
# TEST_DATABASE_URL=""

# The port your Express server will run on locally
PORT=5000
