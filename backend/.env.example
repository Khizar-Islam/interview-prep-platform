# Copy this file, rename the copy to ".env" (no ".example" at the end),
# and fill in the real values below.

# Your PostgreSQL connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Example if using a local Postgres install:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/interview_prep"
DATABASE_URL=""

# Your Anthropic API key, starts with sk-ant-
# Get this from console.anthropic.com > API Keys
ANTHROPIC_API_KEY=""

# The port your Express server will run on locally
PORT=5000
