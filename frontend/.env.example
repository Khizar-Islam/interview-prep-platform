# Copy this file, rename the copy to ".env.local", and fill in the real values.
# .env.local is gitignored; this example file is the only env file committed.

# URL of the Express backend (this one is public, it ends up in the browser)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Google sign-in (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth session encryption secret and the site's own URL
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Same Neon database as the backend (NextAuth stores users/logins here)
DATABASE_URL=""

# Signs the short-lived tokens the backend checks. Must be at least 32
# characters and EXACTLY the same as API_AUTH_SECRET in the backend.
# Never add the NEXT_PUBLIC_ prefix: it must stay on the server.
API_AUTH_SECRET=""
